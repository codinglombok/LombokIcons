{
  "name": "lombokicons",
  "version": "0.2.0",
  "description": "SVG icon set with three render modes (line, bold, duo-tone) driven by CSS custom properties: static SVGs, sprites, CSS, and a tree-shakeable JS API. Zero dependencies. Part of the Lombok Ecosystem.",
  "keywords": [
    "icons",
    "svg",
    "svg-icons",
    "duo-tone",
    "css-custom-properties",
    "sprite",
    "tree-shakeable",
    "zero-dependency",
    "lombok-ecosystem"
  ],
  "homepage": "https://github.com/codinglombok/LombokIcons",
  "bugs": {
    "url": "https://github.com/codinglombok/LombokIcons/issues"
  },
  "license": "Apache-2.0",
  "author": "codinglombok",
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/LombokIcons.git"
  },
  "main": "dist/js/lombokicons.cjs",
  "module": "dist/js/lombokicons.mjs",
  "types": "dist/js/lombokicons.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/js/lombokicons.d.mts",
        "default": "./dist/js/lombokicons.mjs"
      },
      "require": {
        "types": "./dist/js/lombokicons.d.cts",
        "default": "./dist/js/lombokicons.cjs"
      }
    },
    "./css": "./dist/css/lombokicons.css",
    "./css/min": "./dist/css/lombokicons.min.css",
    "./svg/*": "./dist/svg/*",
    "./catalog": "./dist/catalog.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/",
    "src/icons.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=85",
    "lint": "tsc -p tsconfig.check.json",
    "vectors": "python3 vectors/build_vectors.py",
    "doctor": "bash scripts/lombok-doctor.sh LombokIcons",
    "check": "npm run build && npm run lint && npm run coverage && npm run doctor",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
